/dts-v1/;

#include "k3-j722s-altos-v3-base.dtsi"

/ {
	model = "Altos V4";
	csi_vc0: csi-vc0 {
		compatible = "csi-vc";
		port {
			csi0_vc0_ep: endpoint {
				remote-endpoint = <&csi0_in0>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	csi_vc1: csi-vc1 {
		compatible = "csi-vc";
		port {
			csi1_vc0_ep: endpoint {
				remote-endpoint = <&csi1_in0>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	csi_vc2: csi-vc2 {
		compatible = "csi-vc";
		port {
			csi2_vc0_ep: endpoint {
				remote-endpoint = <&csi2_in0>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	csi_vc3: csi-vc3 {
		compatible = "csi-vc";
		port {
			csi3_vc0_ep: endpoint {
				remote-endpoint = <&csi3_in0>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&main_pmx0 {
	main_spi0_pins_default: main-spi0-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x01bc, PIN_OUTPUT, 0)	/* (D20) SPI0_CLK */
			J722S_IOPAD(0x01b4, PIN_OUTPUT, 0)	/* (B20) SPI0_CS0 */
			J722S_IOPAD(0x01c0, PIN_INPUT, 0)	/* (E19) SPI0_D0 */
			J722S_IOPAD(0x01c4, PIN_OUTPUT, 0)	/* (E20) SPI0_D1 */
			J722S_IOPAD(0x0088, PIN_INPUT, 7)	/* (N22) GPMC0_OEn_REn.GPIO0_33 */
			J722S_IOPAD(0x00a8, PIN_OUTPUT, 7)	/* (R27) GPMC0_CSn0.GPIO0_41 */
			J722S_IOPAD(0x01b8, PIN_INPUT, 7)	/* (C20) SPI0_CS1.GPIO1_16 */
		>;
	};

	main_spi1_pins_default: main-spi1-default-pins {
		pinctrl-single,pins = <
			J722S_IOPAD(0x0234, PIN_OUTPUT, 5)	/* (H24) MMC1_CLK.SPI1_CS0 */
			J722S_IOPAD(0x023c, PIN_OUTPUT, 5)	/* (H22) MMC1_CMD.SPI1_CLK */
			J722S_IOPAD(0x0228, PIN_OUTPUT, 5)	/* (J23) MMC1_DAT2.SPI1_D1 */
			J722S_IOPAD(0x0224, PIN_INPUT, 5)	/* (H25) MMC1_DAT3.SPI1_D0 */
			J722S_IOPAD(0x008c, PIN_INPUT, 7)	/* (N23) GPMC0_WEn.GPIO0_34 */
			J722S_IOPAD(0x00ac, PIN_OUTPUT, 7)	/* (P21) GPMC0_CSn1.GPIO0_42 */
			J722S_IOPAD(0x022c, PIN_INPUT, 7)	/* (H20) MMC1_DAT1.GPIO1_44 */
		>;
	};
};

&mcu_pmx0 {
	mcu_spi0_pins_default: mcu-spi0-default-pins {
		pinctrl-single,pins = <
			J722S_MCU_IOPAD(0x008, PIN_OUTPUT, 0)   /* (A9) MCU_SPI0_CLK */
			J722S_MCU_IOPAD(0x000, PIN_OUTPUT, 0)   /* (C12) MCU_SPI0_CS0 */
			J722S_MCU_IOPAD(0x00C, PIN_INPUT, 0)    /* (B12) MCU_SPI0_D0 */
			J722S_MCU_IOPAD(0x010, PIN_OUTPUT, 0)   /* (C11) MCU_SPI0_D1 */
		>;
	};

	mcu_spi1_pins_default: mcu-spi1-default-pins {
		pinctrl-single,pins = <
			J722S_MCU_IOPAD(0x040, PIN_OUTPUT, 4)	/* (B1) MCU_MCAN1_RX.MCU_SPI1_CLK */
			J722S_MCU_IOPAD(0x01c, PIN_INPUT, 3)	/* (B5) MCU_UART0_CTSN.MCU_SPI1_D0 */
			J722S_MCU_IOPAD(0x020, PIN_OUTPUT, 3)	/* (C5) MCU_UART0_RTSN.MCU_SPI1_D1 */
			J722S_MCU_IOPAD(0x02c, PIN_OUTPUT, 3)	/* (C4) WKUP_UART0_CTSN.MCU_SPI1_CS0 */
		>;
	};
};

&cpsw3g_phy0 {
	reset-gpios = <&mcu_gpio0 1 GPIO_ACTIVE_LOW>;
	reset-assert-us = <1000>;
	reset-deassert-us = <1000>;
};

&mcu_spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_spi0_pins_default>;
	ti,spi-num-cs = <1>;

	awr_pmic_1: spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <5000000>;
	};
};

&mcu_spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_spi1_pins_default>;
	ti,spi-num-cs = <1>;

	awr_pmic2: spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <40000000>;
	};
};

&main_spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_spi0_pins_default>;
	ti,spi-num-cs = <1>;

	awr_spi_1: spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <40000000>;
	};
};

&main_spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_spi1_pins_default>;
	ti,spi-num-cs = <1>;

	awr_spi_2: spi@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <40000000>;
	};
};

&mcu_mcan0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mcu_mcan0_pins_default>;
	phys = <&transceiver0>;
};

&csi0_port0 {
	status = "okay";

	csi0_in0: endpoint {
		remote-endpoint = <&csi0_vc0_ep>;
		bus-type = <4>; /* CSI2 DPHY */
		clock-lanes = <0>;
		data-lanes = <1 2 3 4>;
	};
};

&csi1_port0 {
	status = "okay";

	csi1_in0: endpoint {
		remote-endpoint = <&csi1_vc0_ep>;
		bus-type = <4>; /* CSI2 DPHY */
		clock-lanes = <0>;
		data-lanes = <1 2 3 4>;
	};
};

&csi2_port0 {
	status = "okay";

	csi2_in0: endpoint {
		remote-endpoint = <&csi2_vc0_ep>;
		bus-type = <4>; /* CSI2 DPHY */
		clock-lanes = <0>;
		data-lanes = <1 2 3 4>;
	};
};

&csi3_port0 {
	status = "okay";

	csi3_in0: endpoint {
		remote-endpoint = <&csi3_vc0_ep>;
		bus-type = <4>; /* CSI2 DPHY */
		clock-lanes = <0>;
		data-lanes = <1 2 3 4>;
	};
};
